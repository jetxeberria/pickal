# Automatically loaded by `direnv`
# This exposes the uv-managed virtual environment to your shell

export VIRTUAL_ENV="${PWD}/.venv"
export PATH="${VIRTUAL_ENV}/bin:${PATH}"

# pickal — Development Environment
# Atomic Spec: Developer Experience

# Load environment variables from .env file
if [ -f .env ]; then
    export $(cat .env | grep -v '^#' | xargs)
fi

# Set up Python environment
if command -v uv > /dev/null; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Set up project-specific variables
export PICKAL_DEBUG=$PICKAL_DEBUG:-false
export PICKAL_LOG_LEVEL=$PICKAL_LOG_LEVEL:-INFO
export PICKAL_ENV=$PICKAL_ENV:-development

# Set up development server
export FLASK_ENV=development
export DEBUG=True

# Set up database (if applicable)
export DATABASE_URL=${DATABASE_URL:-sqlite:///./test.db}

# Set up logging
export LOG_LEVEL=${LOG_LEVEL:-INFO}

# Set up development tools
export PYTHONPATH="src:$PYTHONPATH"

# Set up test configuration
export PYTEST_ADDOPTS="--cov=src/pickal --cov-report=term-missing --cov-report=html"

# Set up pre-commit hooks
if command -v pre-commit > /dev/null; then
    pre-commit install
fi
