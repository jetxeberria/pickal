# Editor configuration for pickal
# Atomic Spec: Developer Experience

# General settings
root = true

[*]
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4
end_of_line = lf

# Python files
[*.py]
indent_size = 4
max_line_length = 88

# YAML files
[*.{yaml,yml}]
indent_size = 2

# Markdown files
[*.md]
indent_size = 2
max_line_length = off

# Shell files
[*.sh]
indent_size = 4
end_of_line = lf

# JSON files
[*.json]
indent_size = 2

# TOML files
[*.toml]
indent_size = 2